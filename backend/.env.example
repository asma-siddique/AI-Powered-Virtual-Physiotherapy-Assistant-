# Copy to .env for local development. .env is git-ignored; never commit real secrets.

ENVIRONMENT=development

# Leave empty for local development: the API starts an embedded Postgres whose
# data lives in ~/.physioai/pgdata. For the shared/hosted database, paste the
# Supabase connection string (Project settings > Database > Connection string).
DATABASE_URL=

# Leave empty for local development: a random secret is generated once per
# machine in ~/.physioai/dev_jwt_secret. Required (32+ characters) in production.
JWT_SECRET=

# A session whose form score is below this goes to its physiotherapist's
# flagged queue. A session with a RED repetition always does.
FLAG_SCORE_BELOW=60

# How often the API looks for session reminders that have fallen due, in
# seconds. 0 switches reminders off.
REMINDER_INTERVAL_SECONDS=30

# Local demo accounts, created by `python -m app.seed`. These values are for
# local development only and are refused when ENVIRONMENT=production.
SEED_ADMIN_EMAIL=admin@physioai.test
SEED_ADMIN_PASSWORD=Admin-Demo-2026
SEED_PHYSIO_EMAIL=dr.sarah@physioai.test
SEED_PHYSIO_PASSWORD=Physio-Demo-2026
SEED_PATIENT_EMAIL=jane@physioai.test
SEED_PATIENT_PASSWORD=Patient-Demo-2026

# The team's own admin accounts, created by `python -m app.seed --team`:
# asma@physioai.test, rameesha@physioai.test, dure@physioai.test and
# maliha@physioai.test, all with SEED_TEAM_PASSWORD.
SEED_TEAM_ADMINS=Asma Siddique <asma@physioai.test>, Rameesha Shakeel <rameesha@physioai.test>, Dure Sameen <dure@physioai.test>, Maliha Fatima <maliha@physioai.test>
SEED_TEAM_PASSWORD=Admin@123

# Test patients, created by `python -m app.seed --test-patients`, each with
# every exercise: ali@physioai.test, sara@physioai.test, bilal@physioai.test,
# hina@physioai.test and usman@physioai.test, all with this password.
SEED_TEST_PATIENT_PASSWORD=Patient@123
